{
  "_about": "fieldkit hog thresholds. Override any key in state/hog/thresholds.json (same names). Every rule is a number here, never a judgment call.",
  "ram_warn_pct": 80,
  "ram_act_pct": 90,
  "commit_warn_pct": 85,
  "commit_act_pct": 95,
  "top_n": 8,
  "model_idle_min": 15,
  "model_idle_min_critical": 5,
  "leak_window_min": 30,
  "leak_min_samples": 6,
  "leak_growth_mb": 1024,
  "cpu_pinned_pct": 95,
  "cpu_pinned_min": 10,
  "temp_warn_c": 85,
  "temp_act_c": 95,
  "disk_warn_free_pct": 10,
  "disk_act_free_pct": 5,
  "orphan_cap_h": 4,
  "sample_keep_min": 120,
  "sample_top": 40,
  "hook_fresh_min": 15,
  "act_unload_idle_models": true,
  "act_kill_orphans": true,
  "ollama_url": "http://127.0.0.1:11434",
  "orphan_classes": {
    "pytest": "\\bpytest\\b",
    "go-test": "\\bgo(\\.exe)?\\s+test\\b|\\.test(\\.exe)?\\s*$",
    "cargo": "^cargo(\\.exe)?\\b",
    "node": "^node(\\.exe)?\\b",
    "conhost": "^conhost(\\.exe)?\\b|tui_shots",
    "link-listener": "fieldkit\\b.*\\blink\\b.*\\b(serve|listen)\\b",
    "browser": "^(firefox|chrome|msedge|chromium|gorilla)(\\.exe)?\\b"
  }
}
