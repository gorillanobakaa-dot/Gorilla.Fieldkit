#!/bin/sh
# Fieldkit pre-commit: no commit unless the tests pass and nothing private is staged.
# Installed with: git config core.hooksPath hooks
cd "$(git rev-parse --show-toplevel)" || exit 1
# Find an interpreter that ACTUALLY HAS PYTEST. Debian ships python3 with no
# "python" alias, so a bare `python -m pytest` fails with "command not found"
# and the hook then printed "tests failed - commit refused", which is a lie: the
# tests never ran. Refusing is right, but the REASON must be true, and a
# misleading refusal sends somebody hunting a test failure that does not exist.
#
# Each candidate is checked for pytest before being chosen. Do NOT relax this to
# "first interpreter found": on 2026-10-13 an earlier attempt fell back to a
# pytest-less interpreter and made the behaviour worse than the bug it fixed.
PY=""
# 2026-10-22: a commit from a git WORKTREE (Fieldkit-agent-link) was refused here: a worktree has no .venv of its
# own. The main checkout's venv sits beside the shared git folder, so it is a candidate too (still pytest-checked).
MAIN_VENV="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")/.venv/bin/python"
for c in "${VIRTUAL_ENV:+$VIRTUAL_ENV/bin/python}" ./.venv/bin/python "$MAIN_VENV" python3 python; do
  [ -n "$c" ] || continue
  if command -v "$c" >/dev/null 2>&1 && "$c" -c "import pytest" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  echo "pre-commit: COULD NOT RUN THE TESTS - no interpreter with pytest - commit refused"
  echo "  this is NOT a test failure: nothing was verified. Activate the venv or install pytest."
  exit 1
fi
# 2026-10-19: no name lookups on the real network from the hook or anything it starts (fieldkit/core/offline.py):
# the suite's canary children resolved incoming.telemetry.mozilla.org on every commit and the leak gate's DNS witness
# saw it. Any process that imports fieldkit installs the guard; tests/conftest.py extends it to every Python child.
export FIELDKIT_OFFLINE=1
# own temporary folder: a pytest-current link once made by an elevated run cannot be replaced by a normal account,
# and pytest then exits non-zero with every test passed (2026-10-07: every commit refused for that alone)
BT="$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}/fk-hook-$$")"
OUT="$BT.out"
# 2026-10-14: the suite writes about 170 MB of videos into each basetemp; left behind, a dozen commits
# filled /tmp past the point where videokit doctor (needs 5 GB free) failed and refused every commit.
# 2026-10-14: a marker while the hook runs, so a waiter checks a FILE, not the process list. `pgrep -f hooks/pre-commit`
# inside a waiting loop matched the loop's own command line and waited the full 10-minute timeout, several times.
# hooks/wait-for-hook.sh waits on these markers and removes the ones whose process is gone.
MARK="$(git rev-parse --git-common-dir)/pre-commit.running.$$"
# 2026-10-26: the checkout too, so `fieldkit ship ready` in one worktree is not blocked by another worktree's hook
echo "$(date '+%Y-%m-%d %H:%M:%S') $(git rev-parse --show-toplevel)" > "$MARK" 2>/dev/null || true
trap 'rm -rf "$BT" "$OUT" "${BT2:-}" "$MARK"' EXIT
# 2026-10-26: the merge driver for cards and generated indexes (fieldkit/method/mergedriver.py), written into the
# clone's git folder when missing, so the next merge of two card branches does not conflict. Never refuses a commit.
[ -f fieldkit/method/mergedriver.py ] && "$PY" fieldkit/method/mergedriver.py install --quiet 2>/dev/null | sed 's/^/pre-commit: merge driver /'
# 2026-10-14 (owner): a new module must never be blocked by the docs map. Put every module that is in no group into
# its folder's group first, and stage the map; a module in a brand-new folder (or a tie) is refused with the reason.
if [ -f docs/groups.yaml ]; then
  if ! "$PY" -m fieldkit docs assign >"$OUT" 2>&1; then
    cat "$OUT"
    echo "pre-commit: a new module could not be put in a documentation group - commit refused (see above)"
    exit 1
  fi
  if grep -q '^assigned ' "$OUT"; then
    grep '^assigned ' "$OUT" | sed 's/^/pre-commit: /'
    git add docs/groups.yaml
  fi
fi
# 2026-10-26: the suite runs under the one run guard (fieldkit/core/preflight.py): idle local models unloaded and dead
# sessions' orphans stopped first, RAM and temperature sampled during it, one end line after it. A checkout without
# the guard runs the suite bare.
guarded() {
  if "$PY" -c "import fieldkit.core.preflight" >/dev/null 2>&1; then
    "$PY" -m fieldkit.core.preflight --label pre-commit --kind test -- "$@"
  else
    "$@"
  fi
}
# 2026-10-26 (owner: "We can't afford to waste literally thousands of dollars for the tests"; fieldkit/testcost.py):
# the suite does not run again on a tree that ALREADY PASSED it (a commit retried after a privacy refusal, an amend
# of the message, a rebase replay): the key is the hash of exactly the files the tests see. Every run, skip and
# refusal is logged (state/testcost/runs.jsonl), so `fieldkit testcost report` knows what the suite costs and catches.
KEY="$("$PY" -m fieldkit.testcost key 2>/dev/null)" || KEY=""
T0="$(date +%s)"
SKIP=""
if [ -n "$KEY" ] && "$PY" -m fieldkit.testcost seen full-suite --key "$KEY"; then
  SKIP=1
  "$PY" -m fieldkit.testcost record full-suite skipped 0 --key "$KEY" --note "saved=$("$PY" -c 'from fieldkit import testcost as t; print(t.budget("full-suite") or 0)' 2>/dev/null) same tree" || true
elif "$PY" -m fieldkit.testcost docs-only 2>/dev/null; then
  # only with the owner's flag "docs_only_privacy_only" set (fieldkit testcost flags); OFF by default
  echo "pre-commit: documentation only (owner flag docs_only_privacy_only): privacy scan only, the suite is skipped"
  SKIP=1
  "$PY" -m fieldkit.testcost record full-suite skipped 0 --key "$KEY" --note "docs-only flag" || true
elif [ -n "$KEY" ] && [ -f fieldkit/method/mergeproof.py ] && [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  # 2026-10-26 (the merge train, fieldkit/method/mergeproof.py): a merge of CI-green main into a tree that already
  # passed, proven to be ONLY a merge (main's files as they are, generated files equal to their generator, cards merged
  # entry by entry), runs the tests that cover the changed paths instead of the full suite. Any doubt: the full suite.
  if MPT="$("$PY" -m fieldkit.method.mergeproof hook --key "$KEY" 2>"$OUT")"; then
    sed 's/^/pre-commit: /' "$OUT"
    if [ -n "$MPT" ] && ! guarded "$PY" -m pytest -q -p no:cacheprovider --basetemp "$BT" $MPT >"$OUT" 2>&1; then
      tail -20 "$OUT"
      echo "pre-commit: the tests covering this merge failed - commit refused"
      "$PY" -m fieldkit.testcost record merge-proof refused "$(( $(date +%s) - T0 ))" --key "$KEY" >/dev/null 2>&1 || true
      exit 1
    fi
    SKIP=1
    "$PY" -m fieldkit.testcost record merge-proof pass "$(( $(date +%s) - T0 ))" --key "$KEY" \
      --note "$(echo $MPT | wc -w) test file(s)" >/dev/null 2>&1 || true
    "$PY" -m fieldkit.testcost record full-suite skipped 0 --key "$KEY" --note "saved=$("$PY" -c 'from fieldkit import testcost as t; print(t.budget("full-suite") or 0)' 2>/dev/null) merge proof" || true
  else
    sed 's/^/pre-commit: /' "$OUT"
  fi
fi
if [ -z "$SKIP" ] && ! guarded "$PY" -m pytest -q -p no:cacheprovider --basetemp "$BT" -rf >"$OUT" 2>&1; then
  if grep -q '^REFUSED by the preflight' "$OUT"; then
    grep -E '^REFUSED by the preflight|preflight' "$OUT"
    echo "pre-commit: the preflight refused the suite (free RAM under the floor) - commit refused, nothing was tested"
    exit 1
  fi
  # A failure must reproduce before it refuses the commit (2026-10-09: a timing test failed once under load, then
  # passed 3 of 3 on its own). Only the failed tests run again, once, in a fresh folder. A failure that does not
  # reproduce is written to state/flaky-tests.log (time and test) so it gets fixed, never silently forgotten.
  # Anything else (a collection error, no FAILED line, a second failure) refuses the commit.
  FAILED="$(sed -n 's/^FAILED \([^ ]*\).*/\1/p' "$OUT")"
  BT2="$(mktemp -d 2>/dev/null || echo "$BT-again")"
  if [ -z "$FAILED" ] || ! "$PY" -m pytest -q -p no:cacheprovider --basetemp "$BT2" $FAILED >/dev/null 2>&1; then
    echo "pre-commit: tests failed - commit refused (python -m pytest to see why)"
    [ -n "$FAILED" ] && echo "$FAILED"
    "$PY" -m fieldkit.testcost record full-suite refused "$(( $(date +%s) - T0 ))" --key "$KEY" \
      --note "caught: $(echo $FAILED | tr '\n' ' ' | cut -c1-400)" >/dev/null 2>&1 || true
    exit 1
  fi
  mkdir -p state
  for t in $FAILED; do echo "$(date '+%Y-%m-%d %H:%M:%S') failed once, passed when run again: $t" >> state/flaky-tests.log; done
  echo "pre-commit: WARNING - failed once and passed when run again (logged in state/flaky-tests.log): $FAILED"
fi
if [ -z "$SKIP" ]; then
  grep -E '^  (preflight|run guard) ' "$OUT" | sed 's/^  /pre-commit: /'
  "$PY" -m fieldkit.testcost record full-suite pass "$(( $(date +%s) - T0 ))" --key "$KEY" >/dev/null 2>&1 || true
fi
# 2026-10-26 (owner: "align our standard with theirs for maximum compatibility"): every Agent Skills spec rule and the
# doors check of the adopted third-party skills (fieldkit skills validate), ONLY when the commit changes a skill, the
# adopted tree, the installer or the validator - the staged-file question fieldkit/testcost.py asks, answered in the
# shell, so every other commit pays nothing (not even a Python start). The paths mirror fieldkit/skills WATCHED.
if git diff --cached --name-only | grep -qE '^(skills/|third_party/anthropic-skills/|install_skills\.py$|fieldkit/skills/)'; then
  if ! "$PY" -m fieldkit skills validate >"$OUT" 2>&1; then
    cat "$OUT"
    echo "pre-commit: a skill breaks the Agent Skills spec or an adopted skill has an unaccepted door - commit refused"
    exit 1
  fi
  tail -1 "$OUT" | sed 's/^/pre-commit: /'
fi
if ! "$PY" -m fieldkit privacy scan . --git >/dev/null 2>&1; then
  echo "pre-commit: privacy findings in files git would publish - commit refused"
  "$PY" -m fieldkit privacy scan . --git; exit 1
fi
exit 0
